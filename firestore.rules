rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Permanent Saved Links collection
    match /saved_links/{linkId} {
      allow read, write: if true;
    }

    // Permanent Saved Phone Numbers collection
    match /saved_phone_numbers/{phoneId} {
      allow read, write: if true;
    }

    // Permanent Group Safety Reports collection
    match /group_safety_reports/{reportId} {
      allow read, write: if true;
    }
  }
}

# ══════════════════════════════════════════════════════════════════════
#  إعدادات متغيرات البيئة والأسرار — مركز أبو مالك / سرعة إنجاز
#  Environment Variables & Secrets Blueprint
# ══════════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────
# 1. إعدادات الخادم والبيئة (Server & Environment)
# ──────────────────────────────────────────────────
# وضع التشغيل على منصة ريندر (اتركه true على Render)
RENDER=true

# منفذ التشغيل المخصص لخادم الويب (ريندر يضبطه تلقائياً على 10000)
PORT=10000

# إصدار بايثون المدعوم على ريندر
PYTHON_VERSION=3.11.9

# مفتاح تشفير الجلسات والكوكيز (سلسلة نصية عشوائية قوية وطويلة)
SESSION_SECRET=your_long_random_session_secret_here

# ──────────────────────────────────────────────────
# 2. بيانات لوحة الإدارة (Admin Panel Access)
# ──────────────────────────────────────────────────
ADMIN_USERNAME=Anwer
ADMIN_PASSWORD=your_admin_secret_password_here

# ──────────────────────────────────────────────────
# 3. مفاتيح تيليجرام الرسمية (Telegram API Credentials)
# من موقع https://my.telegram.org > API development tools
# ──────────────────────────────────────────────────
TELEGRAM_API_ID=22043994
TELEGRAM_API_HASH=56f64582b363d367280db96586b97801

# ──────────────────────────────────────────────────
# 4. مفاتيح الذكاء الاصطناعي (AI Engines: Gemini & Groq)
# ──────────────────────────────────────────────────
# مفتاح Google Gemini الرئيسي (من https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# المفاتيح الاحتياطية المتتالية لنظام التدوير التلقائي (Sequential Round-Robin)
GEMINI_KEY_1=AIzaSy...
GEMINI_KEY_2=AIzaSy...
GEMINI_KEY_3=AIzaSy...
GEMINI_KEY_4=AIzaSy...
GEMINI_KEY_5=AIzaSy...
GEMINI_API_KEYS=key1,key2,key3,key4,key5

# مفتاح Groq AI للتحليل السريع (من https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# ──────────────────────────────────────────────────
# 5. مزامنة GitHub وحفظ الجلسات سحابياً (GitHub Sync)
# لحفظ ملفات الجلسات (sessions/) والإعدادات عند إعادة تشغيل ريندر
# ──────────────────────────────────────────────────
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_REPO=anwer1230/Anwer_Telegram-
GITHUB_BRANCH=replit-project-import

# رابط خطاف النشر التلقائي من لوحة ريندر (Deploy Hook)
RENDER_DEPLOY_HOOK=https://api.render.com/deploy/srv-daps4mm7bikc738kaflg?key=BSGAfvSu9d4

# ──────────────────────────────────────────────────
# 6. قاعدة البيانات السحابية (PostgreSQL Database)
# ──────────────────────────────────────────────────
# رابط اتصال PostgreSQL (سواء من Render PostgreSQL أو Supabase أو Neon)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME
DB_CONNECT_TIMEOUT=10
DB_RETRIES=2

# ──────────────────────────────────────────────────
# 7. إشعارات الويب والمتصفح (Web Push / VAPID Keys)
# ──────────────────────────────────────────────────
VAPID_PUBLIC_KEY=BIkbfhrnC0MgiZk3KJ8fPTUX300SviFxsJguvQjx6q-TNMxK23yhqhyr5Q5vqad8-k3aD1J7NPWg3GbKHuJdpOc
VAPID_PRIVATE_B64=your_base64_encoded_vapid_private_key_here

# ──────────────────────────────────────────────────
# 8. إشعارات البريد الإلكتروني (Email SMTP - اختياري)
# ──────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_SENDER_NAME=Abu Malk Services
EMAIL_RECIPIENT=your_notification_email@gmail.com
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false

# ──────────────────────────────────────────────────
# 9. معاملات الأمان والتحكم الآلي (Automation Tunables)
# ──────────────────────────────────────────────────
SMART_SALAM_WAIT_SECONDS=3
BATCH_SEND_INTERVAL_SECONDS=5
JOIN_MIN_DELAY_SECONDS=3
JOIN_MAX_DELAY_SECONDS=10
JOIN_MAX_PER_MINUTE=15
JOIN_MAX_PER_HOUR=150
